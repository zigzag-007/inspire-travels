{
  "name": "inspire-travels",
  "version": "2.2.0",
  "private": true,
  "description": "Static website for Inspire Travels & Tours",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test tests/logic/*.test.js",
    "test:e2e": "playwright test --config tests/playwright.config.js routes.spec.js",
    "test:performance": "playwright test --config tests/playwright.config.js performance.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@phosphor-icons/web": "2.1.1",
    "aos": "2.3.1",
    "gsap": "3.13.0",
    "photoswipe": "5.4.3",
    "sharp": "0.35.5",
    "swiper": "12.1.2",
    "tailwindcss": "3.4.17"
  }
}
